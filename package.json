{
  "name": "vibedocs",
  "version": "0.4.1",
  "type": "module",
  "description": "Self-hosted markdown documentation browser with live reload, syntax highlighting, and full-text search",
  "keywords": [
    "documentation",
    "markdown",
    "self-hosted",
    "hono",
    "react",
    "live-reload",
    "shiki",
    "mermaid"
  ],
  "author": "Daniel Bright",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielcbright/vibedocs.git"
  },
  "homepage": "https://github.com/danielcbright/vibedocs",
  "bugs": {
    "url": "https://github.com/danielcbright/vibedocs/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "vibedocs": "./dist-cli/cli/index.js"
  },
  "files": [
    "dist-cli/",
    "frontend/dist/**",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch src/server.ts\" \"cd frontend && npx vite\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:frontend": "cd frontend && npx vite",
    "build": "cd frontend && npm install && npx vite build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "prepare": "node scripts/prepare.mjs",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.cli.json --noEmit",
    "typecheck:frontend": "cd frontend && npm run typecheck",
    "test": "npm run test:backend; backend=$?; npm run test:frontend; frontend=$?; exit $((backend || frontend))",
    "test:backend": "vitest run",
    "test:watch": "vitest",
    "test:frontend": "cd frontend && npx vitest run",
    "verify": "npm run build:cli && npm run typecheck && npm run build && npm run typecheck:frontend && npm test",
    "pack:inspect": "node scripts/pack-inspect.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "overrides": {
    "gray-matter": {
      "js-yaml": "$js-yaml"
    }
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@shikijs/rehype": "^1",
    "chokidar": "^3",
    "esbuild": "^0.28.1",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.1",
    "js-yaml": "^4.3.1",
    "rehype-autolink-headings": "^7",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6",
    "rehype-stringify": "^10",
    "remark-gfm": "^4",
    "remark-parse": "^11",
    "remark-rehype": "^11",
    "tsx": "^4.23.1",
    "unified": "^11",
    "unist-util-visit": "^5",
    "ws": "^8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26",
    "@types/ws": "^8",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "pagefind": "^1.5.2"
  }
}
